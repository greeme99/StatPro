# AI Copilot은 검토된 Rulebase를 먼저 사용합니다. 아래 Gemini 설정이 모두
# 활성화된 경우에만 Rulebase에 없는 질문을 Gemini 2.5 Flash로 보냅니다.
STATPRO_COPILOT_LLM_ENABLED=false
GEMINI_API_KEY=

# 로컬 OpenAI 호환 chat/completions endpoint를 사용할 때만 true로 바꿉니다.
# Loopback HTTP 주소만 허용하며, 활성화되면 Gemini로 우회하지 않습니다.
STATPRO_COPILOT_LOCAL_LLM_ENABLED=false
STATPRO_COPILOT_LOCAL_LLM_URL=http://127.0.0.1:11434/v1/chat/completions
STATPRO_COPILOT_LOCAL_LLM_MODEL=
